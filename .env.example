# Pure MedSpa environment configuration template.
# Copy this file to `.env.local` and fill in real values. Never commit .env files.
# Every VITE_* value is embedded in the public JavaScript bundle, so only
# put PUBLIC URLs here: never passwords, tokens, or API secrets.

# Public Google Calendar appointment-scheduling booking page.
# Create it in Google Calendar > Create > Appointment schedule > Open booking page,
# then copy the link from "Share" (either form works):
#   https://calendar.app.google/XXXXXXXXXXXX                       -> CTAs open it in a new tab
#   https://calendar.google.com/calendar/appointments/schedules/XXXX -> embedded on the page + new-tab link
VITE_GOOGLE_CALENDAR_BOOKING_URL=

# Formspree form ID for consultation enquiries (the part after /f/ in the form's endpoint,
# e.g. https://formspree.io/f/xyzabcde -> xyzabcde). This ID is public by design.
# The RECIPIENT email is set and verified in the Formspree dashboard, not here.
# Leave empty to keep the form clearly labelled as "not yet live".
VITE_FORMSPREE_FORM_ID=

# Optional: public site URL, used for canonical/social metadata after deployment.
# SITE_URL=https://example.com
