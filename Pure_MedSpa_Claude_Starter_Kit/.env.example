# Pure MedSpa environment configuration template.
# Copy this to .env only when a real integration requires it.
# Never commit .env or put private API keys in browser/client-side code.

# Optional: public site URL used for metadata after deployment
# SITE_URL=https://example.com

# Add server-side email/booking/CRM variables only after choosing and configuring
# a provider. Never invent values or paste secrets into source files.
